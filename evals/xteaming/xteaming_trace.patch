+def _save_attack_log(results, output_dir):
+    """Save a clean, flat compilation of all attacks with every turn."""
+    log = []
+    for beh_num, beh_data in results.get("behaviors", {}).items():
+        behavior_text = beh_data.get("behavior", {}).get("Behavior", "")
+        behavior_id = beh_data.get("behavior", {}).get("BehaviorID", "")
+        for strat in beh_data.get("strategies", []):
+            entry = {
+                "behavior_number": beh_num,
+                "behavior_id": behavior_id,
+                "behavior": behavior_text,
+                "set": strat.get("set_number"),
+                "strategy": strat.get("strategy_number"),
+                "strategy_plan": strat.get("strategy_plan", {}),
+                "jailbreak_achieved": strat.get("jailbreak_achieved", False),
+                "jailbreak_turn": strat.get("jailbreak_turn"),
+                "turns": [],
+            }
+            for turn in strat.get("conversation", []):
+                entry["turns"].append({
+                    "turn": turn.get("turn"),
+                    "phase": turn.get("phase"),
+                    "attacker_input": turn.get("attacker", ""),
+                    "target_response": turn.get("target_truncated", ""),
+                    "evaluation_score": turn.get("evaluation_score"),
+                    "evaluation_reason": turn.get("evaluation_reason", ""),
+                })
+            log.append(entry)
+    output_tag = results.get("configuration", {}).get("attacker", {}).get("output_tag", "200")
+    filepath = os.path.join(output_dir, f"attack_log_{output_tag}.json")
+    with open(filepath, "w") as f:
+        json.dump(log, f, indent=2, ensure_ascii=False)
+    logging.info(f"Attack log saved to {filepath} ({len(log)} strategies)")
