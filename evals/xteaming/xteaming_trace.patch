+class SFTTargetModel(BaseAgent):
+    """Target model for SFT-trained LLaMA variants using [Turn N] format.
+
+    SFT models expect the entire conversation collapsed into a single user
+    message with [Turn N] markers, plus a specific system prompt. The
+    state_answer variant produces <STATE>...</STATE><ANSWER>...</ANSWER>
+    output; only the ANSWER is returned and stored in history.
+    """
+
+    def __init__(self, config: Dict):
+        super().__init__(config)
+        self.sft_variant = config.get("sft_variant", "answer_only")
+        self.history = []  # list of {"role": ..., "content": ...}
+        if self.sft_variant == "state_answer_action":
+            # Load updated prompt with action field from file
+            import os
+            prompt_path = os.path.join(os.path.dirname(__file__), "state_answer_action_prompt.txt")
+            with open(prompt_path) as f:
+                self.system_prompt = f.read()
+            # Treat as state_answer for parsing purposes
+            self.sft_variant = "state_answer"
+        elif self.sft_variant == "state_answer":
+            self.system_prompt = STATE_ANSWER_PROMPT
+        else:
+            self.system_prompt = ANSWER_ONLY_PROMPT
+
+    def generate_response(self, attacker_message: str) -> str:
+        """Generate a response using [Turn N] SFT format."""
+        # Build the collapsed conversation as a single user message
+        formatted = _format_sft_conversation(self.history, attacker_message)
+        messages = [
+            {"role": "system", "content": self.system_prompt},
+            {"role": "user", "content": formatted},
+        ]
+
+        raw_response = self.call_api(
+            messages=messages, temperature=self.config["temperature"]
+        )
+
+        # Parse: extract only the ANSWER portion
+        answer = _parse_sft_response(raw_response, self.sft_variant)
+
+        # Store raw response for analysis (not leaked to history or judge)
+        self.last_raw_response = raw_response
+
+        # Store parsed answer in history (no STATE leakage)
+        self.history.append({"role": "user", "content": attacker_message})
+        self.history.append({"role": "assistant", "content": answer})
+
+        return answer
+
+
 class TGTargetModel(BaseAgent):
     """Variant of target model that responds to attacker's messages."""
 
